# Socialization 环境变量模板（复制为 .env）
# .env 不入版本库；所有值均有默认，可直接留空运行。

# 应用
APP_NAME=Socialization
APP_VERSION=0.1.0

# 数据库（SQLite；相对路径解析到项目根目录 data/ 下）
DATABASE_URL=sqlite:///data/socialization.db

# 监听地址与端口（默认仅本机）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS 允许的来源（JSON 数组）
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 受限网络下可配置代理（可选）
# HTTPS_PROXY=http://127.0.0.1:7890
